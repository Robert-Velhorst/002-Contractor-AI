# Contractor.AI local development configuration
#
# Local Compose starts without this file. Copy it to .env when you need to
# override the default local settings:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
#
# Runtime files below are intentionally ignored by git.

NODE_ENV=development
PORT=3000
# Optional explicit bind address. The Windows standalone and ngrok launchers
# always force loopback even when this value is unset.
CONTRACTOR_AI_BIND_HOST=127.0.0.1

# Local is the supported day-to-day mode. Hosted mode requires the managed
# PostgreSQL and EU object-storage settings below before it will become ready.
CONTRACTOR_AI_RUNTIME_MODE=local
# Local first run generates and retains an immutable company identity in its ledger.
# Hosted mode requires this explicit id, with a separate database and private storage.
# Never point a different company at an existing ledger, upload folder or data directory.
CONTRACTOR_AI_COMPANY_ID=
# Only after enrolling this environment in the reviewed company handover.
# Keep the private key outside the repository/package and never copy a source key to the target.
# See docs/COMPANY_HANDOVER.md. Ordinary local startup leaves this blank.
CONTRACTOR_AI_AUTHORITY_KEY_FILE=
CONTRACTOR_AI_STORAGE_MODE=local
# The work board and public worker registration are separate controls.
# Both default on only in non-production local mode; hosted/production defaults
# both to disabled. Enable the board without exposing self-registration by
# setting only WORK_BOARD_ENABLED=true. Review docs/WORK_BOARD.md first.
# CONTRACTOR_AI_WORK_BOARD_ENABLED=true
# CONTRACTOR_AI_WORK_BOARD_REGISTRATION_ENABLED=false
# Hosted only: managed EU PostgreSQL with explicit sslmode=verify-full.
CONTRACTOR_AI_DATABASE_URL=
CONTRACTOR_AI_PUBLIC_URL=
CONTRACTOR_AI_HOSTING_PROVIDER=
CONTRACTOR_AI_HOSTING_REGION=
CONTRACTOR_AI_DATA_RESIDENCY=
CONTRACTOR_AI_DPA_REFERENCE=
CONTRACTOR_AI_POSTGRES_BACKUP_MODE=
CONTRACTOR_AI_OBJECT_VERSIONING_ENABLED=false
CONTRACTOR_AI_BACKUP_POLICY_REFERENCE=
# Hosted only: retained policy or controlled document reference covering
# retention, archival, legal holds, and approved erasure decisions.
CONTRACTOR_AI_RETENTION_POLICY_REFERENCE=
CONTRACTOR_AI_RATE_WINDOW_MS=60000
CONTRACTOR_AI_RATE_LIMIT=240
CONTRACTOR_AI_RATE_BUCKET_LIMIT=5000
# Hosted only: exact HTTPS ingress proxy IP/CIDR entries. Never use true or a
# hop count; local mode leaves proxy trust disabled.
CONTRACTOR_AI_TRUST_PROXY=

# Durable ledger-only autonomous scheduler. Disabled by default for local use.
CONTRACTOR_AI_AUTONOMOUS_SCHEDULER_ENABLED=false
CONTRACTOR_AI_AUTONOMOUS_INTERVAL_SECONDS=300
CONTRACTOR_AI_AUTONOMOUS_LEASE_SECONDS=120

# Optional immutable build identifier exposed in the privacy-minimized support
# bundle. Do not place tokens or deployment credentials here.
CONTRACTOR_AI_RELEASE_SHA=

# Hosted evidence storage. These are deliberately blank for local operation.
# Use an EU-region, DPA-covered S3-compatible provider when hosted support is enabled.
CONTRACTOR_AI_S3_ENDPOINT=
CONTRACTOR_AI_S3_BUCKET=
CONTRACTOR_AI_S3_REGION=eu-central-1
CONTRACTOR_AI_S3_ACCESS_KEY_ID=
CONTRACTOR_AI_S3_SECRET_ACCESS_KEY=
# Defaults to companies/<CONTRACTOR_AI_COMPANY_ID>/evidence. Hosted custom values
# must remain under that company's prefix; use company-restricted provider keys.
CONTRACTOR_AI_S3_PREFIX=
# Readiness verifies PUT and GET access with one stable marker under the prefix.
CONTRACTOR_AI_STORAGE_TIMEOUT_MS=5000
CONTRACTOR_AI_STORAGE_VERIFY_TTL_MS=60000

# Local ledger storage. Keep this directory on an encrypted local disk.
# STATE_FILE is a deprecated one-time import source for a pre-ledger local
# install; it is never written by the active runtime. Leave it blank for new installs.
CONTRACTOR_AI_DATA_DIR=
STATE_FILE=
LEDGER_DB_FILE=./data/contractor-ledger.sqlite

# Local upload storage for field photos, documents, invoices, and evidence.
UPLOAD_DIR=./data/uploads
# Integer between 1024 and 104857600 (100 MiB); blank uses the 10 MiB default.
MAX_UPLOAD_BYTES=10485760
# Cumulative retained evidence quota (10 GiB example). Production hosted mode
# requires this explicitly; local standalone installs retain their own value.
CONTRACTOR_AI_EVIDENCE_STORAGE_MAX_BYTES=10737418240
CONTRACTOR_AI_MULTIPART_MAX_PARTS=64
CONTRACTOR_AI_MULTIPART_MAX_FIELDS=32
CONTRACTOR_AI_MULTIPART_MAX_HEADER_PAIRS=16
CONTRACTOR_AI_MULTIPART_MAX_FIELD_BYTES=65536
CONTRACTOR_AI_READINESS_CACHE_TTL_MS=60000
# Required for authenticated local production backups. Keep the same random
# 32-byte-or-longer secret available to the stopped-runtime restore command.
CONTRACTOR_AI_BACKUP_SIGNING_KEY=
CONTRACTOR_AI_PROCESS_LOCK_REQUIRED=false

# Comma-separated browser origins allowed to call the local API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Credential-free local mode is loopback-only and rejects foreign browser writes.
# Hosted and production modes always require a strong token. Use at least 32
# unpadded random characters; 32 random bytes is recommended.
# The dashboard exchanges it for a short-lived HTTP-only session. API clients
# can continue using Bearer, X-Contractor-AI-Token, X-API-Key, or Basic Auth.
CONTRACTOR_AI_REQUIRE_AUTH=false
CONTRACTOR_AI_AUTH_TOKEN=
CONTRACTOR_AI_SESSION_TTL_SECONDS=28800
CONTRACTOR_AI_LOGIN_RATE_WINDOW_MS=900000
CONTRACTOR_AI_LOGIN_RATE_LIMIT=10
CONTRACTOR_AI_LOGIN_RATE_BUCKET_LIMIT=5000
# Optional production role-token map. Each token must have at least 32 unpadded random characters.
# A field worker must be scoped to a durable worker record or explicit job IDs.
# Preferred: {"operators":[{"id":"owner-main","name":"Owner","role":"owner","token":"..."},{"id":"field-piet","name":"Piet","role":"field_worker","token":"...","workerId":"worker_123"}]}
# Legacy role-keyed strings and objects remain supported. Role values may also be arrays of principals with stable ids.
CONTRACTOR_AI_ROLE_TOKENS=
# Comma-separated provider identifiers allowed to record delivery receipts
# after the matching outbound communication approval has been resolved.
CONTRACTOR_AI_VERIFIED_INTEGRATIONS=

# Optional secure tunnel to this local ledger. The tunnel launcher requires a
# strong owner access key and never changes local SQLite into hosted storage.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
# Optional comma-separated client CIDRs enforced at the ngrok edge.
# The machine starting the tunnel must be allowed to reach the public readiness
# URL so the launcher can verify the edge before announcing it.
NGROK_ALLOW_CIDRS=

# Read-only HAI generic JSON feed export. Use an absolute path inside HAI's
# configured local feed root. The owner key is sent only to the local API.
CONTRACTOR_AI_HAI_FEED_PATH=
CONTRACTOR_AI_HAI_FEED_LIMIT=100

# Live weather is fetched only when an operator requests an assessment. The
# default adapter uses Open-Meteo's public forecast and geocoding APIs without
# an API key. Set to false to require manually recorded weather assessments.
WEATHER_PROVIDER_ENABLED=true
WEATHER_PROVIDER_TIMEOUT_MS=8000
WEATHER_PROVIDER_MAX_RESPONSE_BYTES=262144

# Optional source-grounded conversation analysis using an installed LOCAL Ollama
# model. No model is installed or downloaded automatically. See connected guide.
CONTRACTOR_AI_CHAT_AI_ENABLED=false
CONTRACTOR_AI_CHAT_AI_URL=http://127.0.0.1:11434
CONTRACTOR_AI_CHAT_AI_MODEL=
CONTRACTOR_AI_CHAT_AI_CONTEXT_TOKENS=16384
CONTRACTOR_AI_CHAT_AI_VISION_ENABLED=false
# Separate opt-in: durable server queue for new, unreviewed inbound messages.
CONTRACTOR_AI_CHAT_AI_AUTO_ANALYZE=false

# Optional Meta WhatsApp Cloud API. Keep disabled until the operator has verified
# account ownership, privacy/cost arrangements, webhook delivery and recipients.
# Inject real secrets through the runtime environment, never commit them.
CONTRACTOR_AI_WHATSAPP_ENABLED=false
CONTRACTOR_AI_WHATSAPP_TOKEN=
CONTRACTOR_AI_WHATSAPP_APP_SECRET=
CONTRACTOR_AI_WHATSAPP_VERIFY_TOKEN=
CONTRACTOR_AI_WHATSAPP_PHONE_ID=
CONTRACTOR_AI_WHATSAPP_WABA_ID=
CONTRACTOR_AI_WHATSAPP_VERSION=
CONTRACTOR_AI_WHATSAPP_PRIVACY_REFERENCE=
CONTRACTOR_AI_WHATSAPP_COST_REFERENCE=
CONTRACTOR_AI_WHATSAPP_VERIFICATION_REFERENCE=
