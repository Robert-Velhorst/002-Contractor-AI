# Separate identity service. No company dossiers or uploads belong here.
CONTRACTOR_IDENTITY_MODE=local
CONTRACTOR_IDENTITY_HOST=127.0.0.1
CONTRACTOR_IDENTITY_PORT=3010
CONTRACTOR_IDENTITY_ISSUER=http://127.0.0.1:3010
CONTRACTOR_IDENTITY_DB_FILE=./data/identity/registry.sqlite
# Generate an independent 32-byte base64 key. Keep it outside backups/source control.
CONTRACTOR_IDENTITY_ENCRYPTION_KEY=
# Maintenance only. Keep the backup key separate from backup files and registry keys.
CONTRACTOR_IDENTITY_BACKUP_KEY=
# Set only for a reviewed key rotation. Replace ENCRYPTION_KEY after verification.
CONTRACTOR_IDENTITY_NEW_ENCRYPTION_KEY=
# Private JSON array; see docs/IDENTITY_AND_MEMBERSHIP.md.
CONTRACTOR_IDENTITY_COMPANIES_FILE=./identity-companies.json
# Hosted mode requires a separate PostgreSQL database with verified TLS,
# HTTPS issuer, a trusted reverse proxy, EU-region confirmation and DPA reference.
# Clear DB_FILE when using hosted mode; local mode rejects DATABASE_URL.
CONTRACTOR_IDENTITY_DATABASE_URL=
CONTRACTOR_IDENTITY_TRUST_PROXY=
CONTRACTOR_IDENTITY_EU_REGION_CONFIRMED=false
CONTRACTOR_IDENTITY_DPA_REFERENCE=
